<UserControl x:Class="ControleContabil.Desktop.Views.DocumentosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:ControleContabil.Desktop.Infra">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <WrapPanel Margin="0,0,0,8">
                <ComboBox Width="260" Margin="0,0,8,8" ItemsSource="{Binding EmpresasFiltro}" DisplayMemberPath="RazaoSocial" SelectedItem="{Binding EmpresaSelecionada}" />
                <TextBox Width="230" Margin="0,0,8,8" Padding="6" ToolTip="Buscar pelo nome do arquivo" Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Width="320" Margin="0,0,8,8" ItemsSource="{Binding ObrigacoesDaEmpresa}" SelectedItem="{Binding ObrigacaoSelecionada}">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Nome}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Enviar arquivos" Command="{Binding EnviarCommand}" Margin="0,0,8,8" Padding="12,7" />
                <Button Content="Abrir" Command="{Binding AbrirCommand}" Margin="0,0,8,8" Padding="12,7" />
                <Button Content="Mostrar na pasta" Command="{Binding MostrarNaPastaCommand}" Margin="0,0,8,8" Padding="12,7" />
                <Button Content="Remover" Command="{Binding RemoverCommand}" Margin="0,0,8,8" Padding="12,7" />
            </WrapPanel>
        </StackPanel>
        <DataGrid ItemsSource="{Binding Documentos}" SelectedItem="{Binding Selecionado}" IsReadOnly="True"
                  AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Empresa" Binding="{Binding Empresa}" Width="*" />
                <DataGridTextColumn Header="Arquivo" Binding="{Binding NomeArquivo}" Width="2*" />
                <DataGridTextColumn Header="Obrigação" Binding="{Binding Obrigacao}" Width="2*" />
                <DataGridTextColumn Header="Tamanho" Binding="{Binding TamanhoTexto}" Width="*" />
                <DataGridTextColumn Header="Enviado por" Binding="{Binding EnviadoPor}" Width="*" />
                <DataGridTextColumn Header="Data" Binding="{Binding EnviadoEmUtc, Converter={StaticResource UtcLocal}, ConverterParameter=dd/MM/yyyy HH:mm}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
