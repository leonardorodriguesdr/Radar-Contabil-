<UserControl x:Class="ControleContabil.Desktop.Views.ChecklistsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <ComboBox Width="160" Margin="0,0,8,8" ItemsSource="{Binding Meses}" DisplayMemberPath="Texto" SelectedItem="{Binding MesSelecionado}" />
            <ComboBox Width="220" Margin="0,0,8,8" ItemsSource="{Binding EmpresasFiltro}" DisplayMemberPath="RazaoSocial" SelectedItem="{Binding EmpresaSelecionada}" />
            <ComboBox Width="200" Margin="0,0,8,8" ItemsSource="{Binding AnalistasFiltro}" DisplayMemberPath="Nome" SelectedItem="{Binding AnalistaSelecionado}" />
            <Button Content="Gerar competência" Command="{Binding GerarCompetenciaCommand}" Margin="0,0,8,8" Padding="12,7" />
        </WrapPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding Execucoes}" SelectedItem="{Binding ExecucaoSelecionada}" IsReadOnly="True"
                      AutoGenerateColumns="False" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Empresa" Binding="{Binding EmpresaNome}" Width="2*" />
                    <DataGridTextColumn Header="Checklist" Binding="{Binding Nome}" Width="2*" />
                    <DataGridTextColumn Header="Competência" Binding="{Binding Competencia, StringFormat=MM/yyyy}" Width="*" />
                    <DataGridTextColumn Header="Progresso" Binding="{Binding ProgressoTexto}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="1" />
            <DockPanel Grid.Column="2" Background="White" Margin="0,0,0,0">
                <TextBlock DockPanel.Dock="Top" Text="{Binding TituloDetalhe}" FontSize="17" FontWeight="SemiBold" Margin="12" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Itens}" Margin="12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E2E6EA" BorderThickness="0,0,0,1" Padding="4,9">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Concluido, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="0,0,8,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Descricao}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detalhe}" Foreground="Gray" FontSize="11" Margin="0,3,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
