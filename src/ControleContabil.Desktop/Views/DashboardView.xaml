<UserControl x:Class="ControleContabil.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <WrapPanel Margin="0,0,0,14">
                <ComboBox Width="190" Margin="0,0,10,8" ItemsSource="{Binding Meses}"
                          DisplayMemberPath="Texto" SelectedItem="{Binding MesSelecionado}" />
                <ComboBox Width="220" Margin="0,0,10,8" ItemsSource="{Binding Analistas}"
                          DisplayMemberPath="Nome" SelectedItem="{Binding AnalistaSelecionado}" />
                <Button Content="Atualizar" Command="{Binding AtualizarCommand}" Padding="14,7" />
            </WrapPanel>
            <UniformGrid Columns="5" Margin="0,0,0,16">
                <Border Background="White" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="Total" Foreground="Gray"/><TextBlock Text="{Binding Total}" FontSize="25" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Background="White" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="Finalizadas" Foreground="Gray"/><TextBlock Text="{Binding Finalizadas}" FontSize="25" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Background="White" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="Em dia" Foreground="Gray"/><TextBlock Text="{Binding EmDia}" FontSize="25" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Background="White" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="Próximas" Foreground="Gray"/><TextBlock Text="{Binding Proximas}" FontSize="25" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Background="White" Padding="16"><StackPanel><TextBlock Text="Atrasadas" Foreground="Gray"/><TextBlock Text="{Binding Atrasadas}" FontSize="25" FontWeight="SemiBold"/></StackPanel></Border>
            </UniformGrid>
            <TextBlock Text="{Binding PercentualFinalizado, StringFormat={}{0}% concluído no período}"
                       FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
            <ProgressBar Height="12" Maximum="100" Value="{Binding PercentualFinalizado}" Margin="0,0,0,20" />
            <TextBlock Text="Obrigações que precisam de atenção" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
            <DataGrid ItemsSource="{Binding Atencao}" IsReadOnly="True" AutoGenerateColumns="False"
                      CanUserAddRows="False" HeadersVisibility="Column" MinHeight="180" Margin="0,0,0,18">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Empresa" Binding="{Binding EmpresaNome}" Width="2*" />
                    <DataGridTextColumn Header="Obrigação" Binding="{Binding Nome}" Width="2*" />
                    <DataGridTextColumn Header="Competência" Binding="{Binding CompetenciaTexto}" Width="*" />
                    <DataGridTextColumn Header="Vencimento" Binding="{Binding Vencimento, StringFormat=dd/MM/yyyy}" Width="*" />
                    <DataGridTextColumn Header="Situação" Binding="{Binding SituacaoTexto}" Width="*" />
                    <DataGridTextColumn Header="Responsável" Binding="{Binding ResponsavelNome}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Andamento por analista" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
            <DataGrid ItemsSource="{Binding PorAnalista}" IsReadOnly="True" AutoGenerateColumns="False"
                      CanUserAddRows="False" HeadersVisibility="Column" MinHeight="120">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Analista" Binding="{Binding Nome}" Width="2*" />
                    <DataGridTextColumn Header="Resumo" Binding="{Binding Resumo}" Width="2*" />
                    <DataGridTextColumn Header="Percentual" Binding="{Binding Percentual, StringFormat={}{0}%}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
