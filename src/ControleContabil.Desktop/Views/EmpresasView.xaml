<UserControl x:Class="ControleContabil.Desktop.Views.EmpresasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:ControleContabil.Desktop.Infra">
    <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBox Width="250" Margin="0,0,10,8" Padding="6" Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox Content="Incluir inativas" VerticalAlignment="Center" Margin="0,0,14,8" IsChecked="{Binding IncluirInativas}" />
            <Button Content="Nova empresa" Command="{Binding NovaCommand}" Margin="0,0,8,8" Padding="12,7" />
            <Button Content="Editar" Command="{Binding EditarCommand}" Margin="0,0,8,8" Padding="12,7" />
            <Button Content="Ativar / inativar" Command="{Binding AlternarAtivaCommand}" Margin="0,0,8,8" Padding="12,7" />
            <Button Content="Exportar CSV" Command="{Binding ExportarCsvCommand}" Margin="0,0,8,8" Padding="12,7" />
        </WrapPanel>
        <DataGrid ItemsSource="{Binding Empresas}" SelectedItem="{Binding Selecionada}" IsReadOnly="True"
                  AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Razão social" Binding="{Binding RazaoSocial}" Width="2*" />
                <DataGridTextColumn Header="Nome fantasia" Binding="{Binding NomeFantasia}" Width="*" />
                <DataGridTextColumn Header="CNPJ" Binding="{Binding Cnpj, Converter={StaticResource Cnpj}}" Width="*" />
                <DataGridTextColumn Header="Regime" Binding="{Binding Regime, Converter={StaticResource EnumRotulo}}" Width="*" />
                <DataGridTextColumn Header="Analista" Binding="{Binding Analista.Nome}" Width="*" />
                <DataGridCheckBoxColumn Header="Ativa" Binding="{Binding Ativa}" Width="70" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
